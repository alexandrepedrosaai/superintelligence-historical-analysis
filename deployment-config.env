# Configuração de Deployment - Timeline API
# 
# Este arquivo contém todas as configurações necessárias para o deployment.
# Edite os valores conforme necessário antes de executar o deployment.

# ==============================================================================
# AZURE CONFIGURATION
# ==============================================================================

# Resource Group
RESOURCE_GROUP=superintelligence-rg
LOCATION=eastus

# Azure Container Registry
ACR_NAME=superintelligenceacr
ACR_SKU=Basic

# Azure Kubernetes Service
AKS_NAME=superintelligence-aks
AKS_NODE_COUNT=2
AKS_NODE_SIZE=Standard_DS2_v2
AKS_KUBERNETES_VERSION=  # Deixe vazio para usar a versão padrão

# ==============================================================================
# KUBERNETES CONFIGURATION
# ==============================================================================

# Namespace
NAMESPACE=superintelligence

# Helm Release
RELEASE_NAME=timeline-api

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Image
IMAGE_TAG=latest
IMAGE_PULL_POLICY=Always

# Replicas
REPLICA_COUNT=2

# Resources
CPU_REQUEST=100m
CPU_LIMIT=500m
MEMORY_REQUEST=128Mi
MEMORY_LIMIT=512Mi

# Autoscaling
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=2
AUTOSCALING_MAX_REPLICAS=10
AUTOSCALING_TARGET_CPU=70
AUTOSCALING_TARGET_MEMORY=80

# Service
SERVICE_TYPE=LoadBalancer
SERVICE_PORT=80

# ==============================================================================
# INGRESS CONFIGURATION (Opcional)
# ==============================================================================

INGRESS_ENABLED=false
INGRESS_CLASS=nginx
INGRESS_HOST=timeline-api.yourdomain.com
INGRESS_TLS_ENABLED=false
INGRESS_TLS_SECRET=timeline-api-tls

# ==============================================================================
# MONITORING CONFIGURATION (Opcional)
# ==============================================================================

MONITORING_ENABLED=false
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# ==============================================================================
# ADVANCED CONFIGURATION
# ==============================================================================

# Environment Variables para a aplicação
APP_ENV_NODE_ENV=production
APP_ENV_LOG_LEVEL=info
APP_ENV_PORT=3000

# Probes
LIVENESS_PROBE_INITIAL_DELAY=30
LIVENESS_PROBE_PERIOD=10
READINESS_PROBE_INITIAL_DELAY=10
READINESS_PROBE_PERIOD=5

# ==============================================================================
# DEPLOYMENT OPTIONS
# ==============================================================================

# Opções de deployment
SKIP_INFRASTRUCTURE_PROVISIONING=false
SKIP_IMAGE_BUILD=false
SKIP_HELM_INSTALL=false
DRY_RUN=false

# Timeouts (em segundos)
AKS_CREATION_TIMEOUT=1800  # 30 minutos
HELM_INSTALL_TIMEOUT=600   # 10 minutos
LOADBALANCER_TIMEOUT=300   # 5 minutos

# ==============================================================================
# NOTES
# ==============================================================================
#
# Para usar este arquivo:
# 1. Edite os valores conforme necessário
# 2. Execute: source deployment-config.env
# 3. Execute: ./deploy-one-click.sh
#
# Ou use diretamente no script:
# ./deploy-one-click.sh --config deployment-config.env
#
